# ============================================================================
#  Bayan – BinBaz Fatwa Assistant : environment configuration
#  Copy this file to ".env"  ->  `cp .env.example .env`  and fill in the values.
#  `docker compose` reads ".env" automatically. ".env" is git-ignored (secrets).
#  Every variable below has a safe default. HF_TOKEN is strongly recommended:
#  without it the app falls back to the smaller local model for every answer.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Hugging Face access token
# ----------------------------------------------------------------------------
# Used for the hosted LLM (LLM_BACKEND "api" or "both") and by the GitHub Action
# that syncs to the HF Space. With the default LLM_BACKEND=both the app still
# runs WITHOUT this token — it falls back to the local model — but answers come
# from a much smaller model, so set it if you can.
#
#   Where to get it:
#     1. Sign in at https://huggingface.co
#     2. Open  Settings -> Access Tokens   ( https://huggingface.co/settings/tokens )
#     3. "Create new token" -> type: Read (Fine-grained also works;
#        enable "Make calls to Inference Providers")
#     4. Copy the value (starts with "hf_...") and paste it below.
#
#   Note: Inference has a free tier with rate limits; heavy use may need a paid
#   plan or a specific provider. See https://huggingface.co/docs/inference-providers
HF_TOKEN=

# ----------------------------------------------------------------------------
# LLM backend: hosted API, local model, or hosted with local as FALLBACK
# ----------------------------------------------------------------------------
# Every question costs TWO LLM calls (the answerability gate, then generation),
# so a depleted Inference quota takes the whole app down. Pick how to run:
#
#   api    Hugging Face Inference only. Best quality (72B-class), metered.
#          If the quota runs out, requests fail — the app abstains and says so.
#
#   local  A GGUF model in-process only. No quota, no per-question cost, works
#          offline. Smaller model, so lower Arabic quality than the hosted one.
#
#   both   API first, local as FALLBACK when the API fails (402 out of credits,
#          429 throttled, timeout, provider outage). *** THE DEFAULT *** — used
#          even if this variable is unset. Normal traffic gets the large hosted
#          model and an outage degrades gracefully instead of failing. The
#          fallback only engages BEFORE the first token has been streamed, so
#          text already sent to the user is never spliced with output from a
#          different model.
#
# Because "both" is the default, the app works with NO HF_TOKEN at all: the API
# call fails and the local model answers. The first such request downloads
# ~1.9GB of weights, so it is slow — pre-pull them, or set LLM_BACKEND=api if
# you would rather fail fast than fall back to a smaller model.
LLM_BACKEND=both

# --- hosted API settings (used when LLM_BACKEND is "api" or "both") ---
# Any chat model your HF_TOKEN can reach via Inference Providers.
#   Browse models: https://huggingface.co/models?inference_provider=all&pipeline_tag=text-generation
#   Good Arabic options: Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct,
#                        CohereLabs/aya-expanse-32b
LLM_API_MODEL=Qwen/Qwen2.5-72B-Instruct

# Which inference provider to route through. "auto" = let HF pick an available one.
#   Values: auto | hf-inference | together | fireworks-ai | nebius | ...
#   See the "Providers" list on the model page (right sidebar) for what's available.
LLM_PROVIDER=auto

# Max tokens in the generated answer (higher = longer answers, slower).
LLM_MAX_TOKENS=512

# Sampling temperature. 0.0–0.3 = focused/faithful (recommended for fatwas).
LLM_TEMPERATURE=0.1

# Seconds to wait for the API before failing a request.
LLM_TIMEOUT=120

# How much of each retrieved fatwa (chars) goes into the prompt. Cut at a
# sentence boundary — a ruling chopped before its exception clause can read as
# its own opposite.
LLM_CONTEXT_CHARS=1400

# ----------------------------------------------------------------------------
# Local LLM (used when LLM_BACKEND is "local" or "both")
# ----------------------------------------------------------------------------
# Weights download once from the Hub. Model DOWNLOADS are free — only the
# Inference API is metered — so this works even with a depleted quota.
#
# Default is Falcon-H1-3B-Instruct (TII). Chosen by benchmarking the two jobs
# this app actually needs, not generic leaderboards:
#
#   Falcon-H1-3B-Instruct   gate 3/3 correct, 100% Arabic, cites, ~22 tok/s, 1.9GB
#   Qwen2.5-3B-Instruct     gate 2/3 correct, 100% Arabic, cites, ~27 tok/s, 2.1GB
#   ALLaM-7B-Instruct       gate 2/3 correct, 100% Arabic, cites, ~12 tok/s, 4.3GB
#
# Falcon wins on the numbers: it got every gate verdict right, where Qwen wrongly
# refused an answerable question and flagged a sound premise as false. ALLaM is
# Arabic-native and twice the size, yet scored no better on the gate, ran at half
# the speed, and echoed the source blocks verbatim instead of writing an answer —
# bigger and Arabic-specific did NOT win here.
#
# Alternatives (edit both REPO and FILE together):
#   Lighter (~1GB, weaker):
#     LOCAL_LLM_REPO=tiiuae/Falcon-H1-1.5B-Instruct-GGUF
#     LOCAL_LLM_FILE=Falcon-H1-1.5B-Instruct-Q4_K_M.gguf
#   Arabic-native, but measured WORSE here (slower, weaker gate) — try only if
#   you want to re-evaluate it yourself; needs >8GB RAM:
#     LOCAL_LLM_REPO=bartowski/ALLaM-AI_ALLaM-7B-Instruct-preview-GGUF
#     LOCAL_LLM_FILE=ALLaM-AI_ALLaM-7B-Instruct-preview-Q4_K_M.gguf
LOCAL_LLM_REPO=tiiuae/Falcon-H1-3B-Instruct-GGUF
LOCAL_LLM_FILE=Falcon-H1-3B-Instruct-Q4_K_M.gguf

# Point at a .gguf already on disk to skip the download entirely.
# LOCAL_LLM_PATH=/models/Falcon-H1-3B-Instruct-Q4_K_M.gguf

# Context window and CPU threads for the local model.
LOCAL_LLM_CTX=4096
# LOCAL_LLM_THREADS=8

# The local model (~1.9GB) and BGE-M3 (~2.3GB) do NOT both fit in 4GB. Set this
# to 1 on a small VPS to drop the embedder after retrieval and before
# generation; it reloads on the next question (~7s). Leave 0 if you have RAM.
LOCAL_UNLOAD_EMBEDDER=0

# ----------------------------------------------------------------------------
# Embeddings (BGE-M3) — runs LOCALLY on the VPS
# ----------------------------------------------------------------------------
# Model used to embed the incoming question. Must match the model the prebuilt
# index was built with (BAAI/bge-m3). Change ONLY if you rebuild the index.
#   Downloaded once from https://huggingface.co/BAAI/bge-m3 into HF_HOME.
EMB_MODEL_NAME=BAAI/bge-m3

# Use fp16 for the embedder. Keep 0 on CPU (fp16 on CPU is slow/unstable);
# set 1 only if you run on a GPU.
EMB_USE_FP16=0

# ----------------------------------------------------------------------------
# Retrieval tuning
# ----------------------------------------------------------------------------
# Weight on question-to-question similarity vs answer-chunk similarity. The old
# index put 81% answer text in every vector while users send short questions,
# which compressed a perfect self-match to a median cosine of 0.815.
# Re-tune with: python eval/run_retrieval_eval.py --tag mychange
RETRIEVAL_ALPHA=0.65

# Fuse BM25 with dense retrieval via RRF. Dense similarity blurs the exact
# terminology Arabic religious text turns on; BM25 recovers it.
RETRIEVAL_HYBRID=1

# Diversify the top-k with MMR. 1.5% of this corpus has a near-twin at >=0.99
# similarity, so without this the top-5 can be filled with copies of one fatwa.
RETRIEVAL_MMR=1
# 1.0 = pure relevance, lower = more diverse.
RETRIEVAL_MMR_LAMBDA=0.7

# Candidates fused before diversification.
RETRIEVAL_DEPTH=50

# ----------------------------------------------------------------------------
# Answerability gate
# ----------------------------------------------------------------------------
# The gate decides whether to answer at all. It runs before generation and
# FAILS CLOSED: if it errors, the app abstains rather than answering ungrounded.
# Defaults to LLM_API_MODEL; set this to use a cheaper/faster model for the
# verdict than for the answer.
# GATE_MODEL=Qwen/Qwen2.5-72B-Instruct
GATE_MAX_TOKENS=400
# Keep at 0.0 — verdicts should be deterministic.
GATE_TEMPERATURE=0.0
# Chars of each candidate fatwa shown to the gate.
GATE_SNIPPET_CHARS=600

# ----------------------------------------------------------------------------
# Abuse protection
# ----------------------------------------------------------------------------
# Each question costs two LLM calls, so an unthrottled endpoint drains the
# quota (or the bill) fast. Fixed window, per client.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Comma-separated origin allowlist for the browser API. "*" is fine here since
# the API is unauthenticated and sends no credentials.
CORS_ORIGINS=*

# Honour X-Forwarded-For for rate-limit identity. Set 1 ONLY when a trusted
# proxy (Coolify, nginx) sits in front — otherwise anyone can rotate the header
# and get a fresh quota window on every request.
TRUST_PROXY_HEADER=0

# ----------------------------------------------------------------------------
# Observability (optional)
# ----------------------------------------------------------------------------
# Append one JSONL record per question: text, verdict, latency. No client
# identity is recorded. Leave empty to disable. Useful for growing the eval
# sets from real traffic — false abstentions and wrong answers are the rows
# worth adding to eval/datasets/.
# QUERY_LOG_PATH=/app/data/query_log.jsonl

# ----------------------------------------------------------------------------
# Idle RAM release
# ----------------------------------------------------------------------------
# BGE-M3 (~2.3GB) loads on the first question and is unloaded after this many
# seconds with no traffic, returning the RAM to the OS for other projects.
# It reloads automatically on the next question. Set 0 to keep it always loaded.
MODEL_IDLE_TIMEOUT=600
# How often (seconds) the background monitor checks for idleness.
MODEL_IDLE_CHECK_INTERVAL=60

# ----------------------------------------------------------------------------
# Server / runtime
# ----------------------------------------------------------------------------
# Host port to expose the app on (container always listens on 8000 internally).
PORT=8000
# CPU threads for the embedder's math. Set to your VPS vCPU count.
OMP_NUM_THREADS=4

# HF_HOME is fixed to /models inside the container (a persistent Docker volume),
# so downloaded weights survive restarts. No need to change it here.
