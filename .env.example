# ============================================================================
#  Bayan – BinBaz Fatwa Assistant : environment configuration
#  Copy this file to ".env"  ->  `cp .env.example .env`  and fill in the values.
#  `docker compose` reads ".env" automatically. ".env" is git-ignored (secrets).
#  Every variable below has a safe default EXCEPT HF_TOKEN, which is required.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Hugging Face access token
# ----------------------------------------------------------------------------
# The LLM runs on the Hugging Face Inference API (no local LLM). This token
# authenticates those calls (and is also what the GitHub Action uses to sync
# to the HF Space, so you likely already have one).
#
#   Where to get it:
#     1. Sign in at https://huggingface.co
#     2. Open  Settings -> Access Tokens   ( https://huggingface.co/settings/tokens )
#     3. "Create new token" -> type: Read (Fine-grained also works;
#        enable "Make calls to Inference Providers")
#     4. Copy the value (starts with "hf_...") and paste it below.
#
#   Note: Inference has a free tier with rate limits; heavy use may need a paid
#   plan or a specific provider. See https://huggingface.co/docs/inference-providers
HF_TOKEN=

# ----------------------------------------------------------------------------
# LLM (hosted, streaming)
# ----------------------------------------------------------------------------
# Any chat model your HF_TOKEN can reach via Inference Providers.
#   Browse models: https://huggingface.co/models?inference_provider=all&pipeline_tag=text-generation
#   Good Arabic options: Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct,
#                        CohereLabs/aya-expanse-32b
LLM_API_MODEL=Qwen/Qwen2.5-72B-Instruct

# Which inference provider to route through. "auto" = let HF pick an available one.
#   Values: auto | hf-inference | together | fireworks-ai | nebius | ...
#   See the "Providers" list on the model page (right sidebar) for what's available.
LLM_PROVIDER=auto

# Max tokens in the generated answer (higher = longer answers, slower).
LLM_MAX_TOKENS=512

# Sampling temperature. 0.0–0.3 = focused/faithful (recommended for fatwas).
LLM_TEMPERATURE=0.1

# Seconds to wait for the API before failing a request.
LLM_TIMEOUT=120

# How much of each retrieved fatwa (chars) and how many fatwas go into the prompt.
LLM_CONTEXT_CHARS=800
LLM_MAX_HITS=3

# ----------------------------------------------------------------------------
# Embeddings (BGE-M3) — runs LOCALLY on the VPS
# ----------------------------------------------------------------------------
# Model used to embed the incoming question. Must match the model the prebuilt
# index was built with (BAAI/bge-m3). Change ONLY if you rebuild the index.
#   Downloaded once from https://huggingface.co/BAAI/bge-m3 into HF_HOME.
EMB_MODEL_NAME=BAAI/bge-m3

# Use fp16 for the embedder. Keep 0 on CPU (fp16 on CPU is slow/unstable);
# set 1 only if you run on a GPU.
EMB_USE_FP16=0

# ----------------------------------------------------------------------------
# Idle RAM release
# ----------------------------------------------------------------------------
# BGE-M3 (~2.3GB) loads on the first question and is unloaded after this many
# seconds with no traffic, returning the RAM to the OS for other projects.
# It reloads automatically on the next question. Set 0 to keep it always loaded.
MODEL_IDLE_TIMEOUT=600
# How often (seconds) the background monitor checks for idleness.
MODEL_IDLE_CHECK_INTERVAL=60

# ----------------------------------------------------------------------------
# Server / runtime
# ----------------------------------------------------------------------------
# Host port to expose the app on (container always listens on 8000 internally).
PORT=8000
# CPU threads for the embedder's math. Set to your VPS vCPU count.
OMP_NUM_THREADS=4

# HF_HOME is fixed to /models inside the container (a persistent Docker volume),
# so downloaded weights survive restarts. No need to change it here.
